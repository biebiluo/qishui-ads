#!name=汽水音乐净化
#!desc=墨鱼版 QiShuiMusicAds V1.0.6 转 Shadowrocket 模块 V1.1：拦截开屏/视频/弹窗广告，清理推广位；新增穿山甲 SDK 直连拦截
#!author=ddgksf2013（原 QX 配置）

[MITM]
hostname = %APPEND% beta-luna.douyin.com, api.qishui.com, *.zijieapi.com

[Rule]
# > 穿山甲广告 SDK（开屏广告来源，无需 MITM，直接拒绝连接）
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.co,REJECT

[Rewrite]
# > 视频广告
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/media_ads url reject-200
# > 通用广告
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/ads url reject-200
# > 位置隐私
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/location\/info url reject-200
# > 广告弹窗
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/commerce url reject-200
# > TAGS推荐
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/hashtag\/recommend url reject-200
# > DNS处理
^https:\/\/tnc.*zijieapi\.com\/get_domains url reject-200
# > 我的页面推广
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/me\? url script-response-body https://raw.githubusercontent.com/biebiluo/qishui-ads/main/qishui-response.js
# > 会员免费听整月VIEW
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/card url script-response-body https://raw.githubusercontent.com/biebiluo/qishui-ads/main/qishui-response.js
# > 热门搜索
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/search-block url script-response-body https://raw.githubusercontent.com/biebiluo/qishui-ads/main/qishui-response.js
# > 搜索界面活动
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/activities url script-response-body https://raw.githubusercontent.com/biebiluo/qishui-ads/main/qishui-response.js
# > 音乐流推广
^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/feed\/song-tab url script-response-body https://raw.githubusercontent.com/biebiluo/qishui-ads/main/qishui-response.js
